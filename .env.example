# Copy to `.env` (git-ignored) and adjust. Without a .env the whole stack runs with
# deterministic fake providers: no API key is needed for the demo or the tests.

# --- LLM & embeddings providers -------------------------------------------------
# fake    = deterministic and offline (default)
# litellm = a real provider through LiteLLM
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake

# Real provider example (Gemini through LiteLLM), the configuration in eval/reports/gemini.md:
# LLM_PROVIDER=litellm
# LLM_MODEL=gemini/gemini-3.5-flash-lite
# LLM_FALLBACK_MODELS=["gemini/gemini-3-flash-preview"]   # tried when the primary fails
# LLM_REASONING_EFFORT=minimal       # Gemini 3 "thinking" by default: 58.7 s vs 3.3 s measured
# EMBEDDING_PROVIDER=litellm
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# GEMINI_API_KEY=your-key-here
# (Free tier: gemini-3-flash allows only 20 requests a day per model.)
#
# The evidence gate depends on the embedding model (similarities are not comparable across
# models). Defaults suit the fake embedder. For gemini-embedding-001, calibrated on the
# evaluation set: answerable questions scored 0.66-0.79 and unanswerable ones 0.49-0.70.
# RETRIEVAL_MIN_SIMILARITY=0.64      # highest value that refuses no answerable question
# CONFIDENCE_HIGH_SIMILARITY=0.72    # above anything an unanswerable question reached
# RETRIEVAL_MODE=vector              # measured: MRR 0.98 vs 0.86 for hybrid with this embedder

# --- Ingestion tuning (defaults shown; see DECISIONS.md for the rationale) ---------
# MAX_UPLOAD_MB=20
# MAX_PDF_PAGES=300
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# INGEST_MAX_RETRIES=5          # transient errors, exponential backoff with jitter
# INGEST_MAX_ATTEMPTS=6         # poison-message guard
# STALE_PENDING_AFTER_S=120     # reconciler re-enqueues documents stuck this long

# --- Local infrastructure (development only) ---------------------------------------
# POSTGRES_PASSWORD=marea
